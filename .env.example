# Copy to .env.local for local overrides.

# Ad slots always reserve their fixed height so layout never shifts.
# Set to "true" only once there is real traffic and an ad provider wired up.
VITE_ADS_ENABLED=false

# Supabase — powers the daily leaderboard and the global play counter.
# Leave both blank and the game still works; those two features just go dark.
# Find these in your Supabase project: Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
